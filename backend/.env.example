# Copy to .env (setup.sh does this). Never commit .env.
# Database: SQLite file (backend/db.sqlite3). MySQL is commented out in config/settings/base.py.
SQLITE_NAME=db.sqlite3
# MySQL (only if you re-enable it in base.py)
# MASTER_DB_NAME=counselqueue
# MASTER_DB_USER=
# MASTER_DB_PASSWORD=
# MASTER_DB_HOST=127.0.0.1
# SLAVE_DB_NAME=counselqueue
# SLAVE_DB_USER=
# SLAVE_DB_PASSWORD=
# SLAVE_DB_HOST=127.0.0.1
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
MESSAGING_PROVIDER=apps.messaging.providers.stub.StubProvider
# Comma-separated normalised mobiles the stub provider fails for (tests / demos)
MESSAGING_STUB_FAIL_TO=
# Base of the student's live token link sent in WhatsApp messages: {FRONTEND_BASE_URL}/t/{access_key}
FRONTEND_BASE_URL=http://localhost:5173
OTP_TTL_MIN=10
OTP_RESEND_SEC=30
OTP_MAX_ATTEMPTS=5
# Accepted in DEBUG/stub mode only
OTP_STUB_CODE=1234
# seed_demo passwords outside DEBUG (unset = unusable passwords)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
