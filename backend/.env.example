# Copy to .env and fill in. Never commit .env.
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/counselqueue
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
MESSAGING_PROVIDER=apps.messaging.providers.stub.StubProvider
# Comma-separated normalised mobiles the stub provider fails for (tests / demos)
MESSAGING_STUB_FAIL_TO=
OTP_TTL_MIN=10
OTP_RESEND_SEC=30
OTP_MAX_ATTEMPTS=5
# Accepted in DEBUG/stub mode only
OTP_STUB_CODE=1234
# seed_demo passwords outside DEBUG (unset = unusable passwords)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
