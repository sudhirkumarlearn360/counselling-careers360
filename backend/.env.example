# Copy to .env and fill in (loaded with python-dotenv). Never commit .env.
# MySQL, same layout as cnext-backend-deb (port is fixed at 3306 in settings).
# "default" (writes, locking reads) uses MASTER_DB_*; read-only report queries may use "slave".
MASTER_DB_NAME=counselqueue
MASTER_DB_USER=
MASTER_DB_PASSWORD=
MASTER_DB_HOST=127.0.0.1
# Locally the slave can point at the same database as the master.
SLAVE_DB_NAME=counselqueue
SLAVE_DB_USER=
SLAVE_DB_PASSWORD=
SLAVE_DB_HOST=127.0.0.1
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
MESSAGING_PROVIDER=apps.messaging.providers.stub.StubProvider
# Comma-separated normalised mobiles the stub provider fails for (tests / demos)
MESSAGING_STUB_FAIL_TO=
OTP_TTL_MIN=10
OTP_RESEND_SEC=30
OTP_MAX_ATTEMPTS=5
# Accepted in DEBUG/stub mode only
OTP_STUB_CODE=1234
# seed_demo passwords outside DEBUG (unset = unusable passwords)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
